# Optional keys. Copy to .env (git ignores it) and fill in. Never commit real keys.
MIRELO_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=
# Name used in Unsplash credit links (utm_source); your registered app name. UNSPLASH_APP_ID / UNSPLASH_SECRET_KEY are not needed.
# UNSPLASH_APP_NAME=video-monk
# PEXELS_API_KEY=

# ElevenLabs narration for educational shorts (video-monk short, and Shorts in the web studio). Key: elevenlabs.io > Developers > API keys.
ELEVENLABS_API_KEY=
# Optional: your default voice (an id from `video-monk short --voices`) and model.
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL_ID=eleven_v4
